<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="hr_department_org_chart.HrDepartmentOrgChart" owl="1">
        <div class="o_department_org_chart" t-ref="org_chart_root">

            <t t-if="state.isLoading">
                <div class="text-center py-5">
                    <i class="fa fa-spinner fa-spin fa-3x text-primary"/>
                    <div class="mt-3">Loading the organization chart...</div>
                </div>
            </t>

            <t t-elif="state.errorMessage">
                <div class="alert alert-warning m-3" role="alert">
                    <i class="fa fa-exclamation-triangle me-2"/>
                    <t t-esc="state.errorMessage"/>
                </div>
            </t>

            <t t-elif="state.root">
                <div class="o_org_chart_container" t-ref="org_chart_container">

                    <!-- Ancestors: one row per department above the current one -->
                    <t t-foreach="state.ancestors" t-as="dept" t-key="dept.id">
                        <div class="o_ancestor_row">
                            <div class="o_dept_box ancestor"
                                 t-att-data-id="dept.id"
                                 t-att-style="'background: ' + getColorForAbsoluteLevel(dept_index + 1)">
                                <div class="name" t-esc="dept.name"/>
                                <div class="employees" t-esc="dept.employees + ' employees'"/>
                                <div class="manager" t-esc="dept.manager"/>
                            </div>
                        </div>
                    </t>

                    <!-- Current department -->
                    <div class="o_current_row">
                        <div class="o_current_box"
                             t-att-data-id="state.root.id"
                             t-att-style="'background: ' + getColorForAbsoluteLevel(state.ancestors.length + 1)">
                            <div class="name" t-esc="state.root.name"/>
                            <div class="level">
                                <t t-esc="state.root.employees + ' employees'"/> (Current)
                            </div>
                            <div class="manager" t-esc="state.root.manager"/>

                            <t t-if="state.root.hasChildren">
                                <button type="button"
                                        class="o_expand_btn"
                                        t-att-aria-label="isExpanded(state.root.id) ? 'Collapse sub-departments' : 'Expand sub-departments'"
                                        t-att-title="isExpanded(state.root.id) ? 'Collapse' : 'Expand'"
                                        t-on-click="(e) => this.toggleNode(state.root.id, e)">
                                    <i t-att-class="isExpanded(state.root.id) ? 'fa fa-minus' : 'fa fa-plus'"/>
                                </button>
                            </t>
                        </div>
                    </div>

                    <!-- Descendants: one row per level -->
                    <div class="o_descendants">
                        <t t-foreach="levels" t-as="level" t-key="level">
                            <div class="o_level">
                                <t t-foreach="getNodesAtLevel(level)" t-as="dept" t-key="dept.id">
                                    <div class="o_dept_box"
                                         t-att-data-id="dept.id"
                                         t-att-style="'background: ' + getColorForAbsoluteLevel(state.ancestors.length + 1 + dept.level)">
                                        <div class="name" t-esc="dept.name"/>
                                        <div class="employees" t-esc="dept.employees + ' employees'"/>
                                        <div class="manager" t-esc="dept.manager"/>

                                        <t t-if="dept.hasChildren">
                                            <button type="button"
                                                    class="o_expand_btn"
                                                    t-att-aria-label="isExpanded(dept.id) ? 'Collapse sub-departments' : 'Expand sub-departments'"
                                                    t-att-title="isExpanded(dept.id) ? 'Collapse' : 'Expand'"
                                                    t-on-click="(e) => this.toggleNode(dept.id, e)">
                                                <i t-att-class="isExpanded(dept.id) ? 'fa fa-minus' : 'fa fa-plus'"/>
                                            </button>
                                        </t>
                                    </div>
                                </t>
                            </div>
                        </t>
                    </div>

                </div>
            </t>

            <t t-elif="!state.isLoading">
                <div class="text-center py-5 text-muted">
                    No organization chart data to display.
                </div>
            </t>

        </div>
    </t>
</templates>
